{
    "name": "alveby/atrium-bitrix",
    "description": "Move a 1C-Bitrix site to Laravel and Atrium: models, migrations, data, forms and SEO",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "bitrix",
        "migration",
        "multisite",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.2",
        "nette/php-generator": "^4.1",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Bitrix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Bitrix\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atrium\\Bitrix\\BitrixServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
